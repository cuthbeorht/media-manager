{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: PySide6 App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/MediaManager/__init__.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "(gdb) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "/Users/samus/src/media-manager/.venv/bin/python3",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb", "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}